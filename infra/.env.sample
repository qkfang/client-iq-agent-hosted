# Copy this file to `.env` (same folder) and fill in the values. The real
# `.env` is git-ignored; Load-InfraEnv.ps1 (preprovision hook) syncs every
# entry into the azd environment so Bicep provisioning and the post-provision
# Python scripts pick them up automatically.
#
# Format: KEY=VALUE (one per line, no quotes). Lines starting with # are ignored.

# --- Web App sign-in (Microsoft Entra OAuth) ------------------------------
# Enables the CRM Web App login button. When AZURE_AD_CLIENT_ID is empty the
# app runs unauthenticated.
AZURE_AD_INSTANCE=https://login.microsoftonline.com/
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_CALLBACK_PATH=/signin-oidc

# --- Foundry onboarding agent --------------------------------------------
# Id/name of the SalesCRMOnboarding agent used by the CRM Web App. Leave empty
# to onboard candidates locally.
ONBOARDING_AGENT_ID=

# --- Fabric workspace ----------------------------------------------------
# Comma-separated UPNs/object ids granted Fabric workspace admin.
FABRIC_WORKSPACE_ADMINISTRATORS=

# --- Optional -------------------------------------------------------------
# GitHub token used when the installer notebook pulls sample content.
GITHUB_TOKEN=
# Log verbosity for the deployment scripts (INFO or DEBUG).
LOG_LEVEL=INFO
