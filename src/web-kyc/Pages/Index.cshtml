@page
@model IndexModel
@{
    ViewData["Title"] = "KYC / AML checks";
}

<section class="page-head">
    <div>
        <h1>KYC / AML checks</h1>
        <p class="page-intro">Customer identification programme (CIP) progress for every client in scope. The Foundry agent pushes each step through MCP using the customer id as the tracking key — this board updates live.</p>
    </div>
    <span class="live-pill" data-live-pill>Live</span>
</section>

<div class="customer-grid" data-customer-list>
    <p class="empty-state">Loading customers…</p>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/kyc-list.js" asp-append-version="true"></script>
}
